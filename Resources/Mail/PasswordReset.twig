{% extends "Layouts/Default.html" %}
{% block mailcontent %}
	<h3>{% if formalSpeech %}Guten Tag{% else %}Hallo{% endif %} {{client.first_name}} {{client.last_name}},</h3>
	<p>
		{% if formalSpeech %}Ihr Passwort wurde zurückgesetzt. Mit dem folgenden Link können Sie Ihr Passwort neu setzen.{% else %}Dein Passwort wurde zurückgesetzt. Mit dem folgenden Link kannst Du Dein Passwort neu setzen.{% endif %}<br><br>
		<a href="{{protocol}}{{domain}}{{settings.client.pages.resetPassword}}?mail={{client.mail}}&hash={{client.hash}}" class="button">Passwort zurücksetzen</a><br><br>{% if formalSpeech %}Nutzen Sie diesen Link{% else %}Nutze diesen Link{% endif %} <a href="{{protocol}}{{domain}}{{settings.client.pages.resetPassword}}?mail={{client.mail}}&hash={{client.hash}}" target="_blank">{{protocol}}{{domain}}{{settings.client.pages.resetPassword}}?mail={{client.mail}}&hash={{client.hash}}</a> sollte der Knopf nicht richtig dargestellt werden.<br>
		<br>
		<strong>ACHTUNG!!!</strong><br>
		Dieser Link läuft am {{client.expire}} Uhr ab.
	</p>
{% endblock %}
