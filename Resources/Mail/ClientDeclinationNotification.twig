{% extends "Layouts/Default.html" %}
{% block mailcontent %}
	<h3>{% if formalSpeech %}Guten Tag,{% else %}Hallo,{% endif %}</h3>
	<p>
		{% if formalSpeech %}Ihre Registrierung wurde abgelehnt.{% else %}Deine Registrierung wurde abgelehnt!{% endif %}<br>
		{% if formalSpeech %}Wir bitten um Ihr Verständnis.{% else %}Wir bitten um Dein Verständnis.{% endif %}
	</p>
	<p>
		{% if formalSpeech %}Sollten Sie Fragen zu Ihrer Registrierung haben, wenden Sie sich bitte direkt an uns{% else %}Solltest Du Fragen zu Deiner Registrierung haben wende Dich direkt an uns{% endif %}<br><br>
		<a href="{{protocol}}{{domain}}/kontakt" class="button">Kontaktanfrage!</a>
	</p>
	<p>
		Viele Grüße!
	</p>
{% endblock %}
